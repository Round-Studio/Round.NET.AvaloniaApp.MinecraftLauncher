<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Plugin.BedrockBoot.Views.Pages.MainSubPage.SettingsPage">
    <ScrollViewer>
        <StackPanel Margin="15">
            <onePointControls:SettingCard Margin="5,5,5,10"
                                          Header="下载"
                                          Description="BedrockBoot 下载时的行为"
                                          Glyph="&#xE896;"
                                          IsClickable="True">
                <ComboBox Margin="5,0"
                          VerticalAlignment="Center"
                          Height="32"
                          Name="ComboBox"
                          HorizontalAlignment="Stretch">
                    <ComboBox.Items>
                        <ComboBoxItem Content="正式版"></ComboBoxItem>
                        <ComboBoxItem Content="预览版"></ComboBoxItem>
                        <ComboBoxItem Content="Beta 版"></ComboBoxItem>
                    </ComboBox.Items>
                </ComboBox>
            </onePointControls:SettingCard>
            
            <onePointControls:SettingCard Margin="5,5,5,10"
                                          Header="目录与存储"
                                          Description="游戏目录，存储相关设置项"
                                          Glyph="&#xE8B7;"
                                          IsClickable="True"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
