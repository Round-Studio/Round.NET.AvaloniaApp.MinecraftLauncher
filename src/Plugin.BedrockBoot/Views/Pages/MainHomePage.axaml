<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Plugin.BedrockBoot.Views.Pages.MainHomePage"
             Background="{DynamicResource BackgroundBrush}">
    <Grid>
        <Border Background="{DynamicResource PrimaryBackgroundBrush}"
                VerticalAlignment="Top"
                Height="48">
            <Grid>
                <TabControl Margin="8,0,0,0"
                            VerticalAlignment="Center">
                    <TabItem Header="管理实例"></TabItem>
                    <TabItem Header="下载实例"></TabItem>
                    <TabItem Header="插件设置"></TabItem>
                </TabControl>
                
                <onePointControls:LabelBox Text="BedrockBoot"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
