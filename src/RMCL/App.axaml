<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RMCL.App"
             xmlns:local="using:RMCL"
             xmlns:core="clr-namespace:OnePointUI.Avalonia.Style.Core;assembly=OnePointUI.Avalonia"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
  
    <Application.Styles>
        <!--<core:OnePointTheme AccentColor="#1EA5FF" ThemeVariant="Dark"/>-->
        
        <core:OnePointTheme AccentColor="Orange" ThemeVariant="Dark"/>
    </Application.Styles>
             
    <Application.Resources>
        <FontFamily x:Key="DinPro">/Assets/Font/DinPro.ttf#DINPro</FontFamily>
    </Application.Resources>
</Application>