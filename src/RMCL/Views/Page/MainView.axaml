<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="RMCL.Views.Page.MainView">
    <Grid RowDefinitions="48,*">
        <Grid>
            <StackPanel Orientation="Horizontal">
                <Button Classes="NoBorder"
                        Width="32" Height="32">
                    <onePointControls:FontIcon Glyph="&#xE701;"/>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
