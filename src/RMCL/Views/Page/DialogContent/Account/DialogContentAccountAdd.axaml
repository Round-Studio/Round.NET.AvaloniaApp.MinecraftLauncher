<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
             mc:Ignorable="d" d:DesignWidth="380"
             Width="380"
             x:Class="RMCL.Views.Page.DialogContent.Account.DialogContentAccountAdd">
    <Grid>
        <TabControl>
            <TabItem Header="离线登录" IsSelected="True">
                <StackPanel Margin="10">
                    <Grid>
                        <TextBlock Margin="5"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left">离线用户名：</TextBlock>
                        <onePointControls:LabelBox Text="请始终考虑正版"
                                                   HorizontalAlignment="Right"
                                                   Margin="5"
                                                   VerticalAlignment="Center"/>   
                    </Grid>
                    <TextBox Margin="0,5"
                             Width="350"
                             HorizontalAlignment="Stretch"></TextBox>
                </StackPanel>
            </TabItem>
            <TabItem Header="微软正版"></TabItem>
            <TabItem Header="第三方登录" IsEnabled="False"></TabItem>
        </TabControl>
    </Grid>
</UserControl>
