<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
             xmlns:notice="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls.Notice;assembly=OnePointUI.Avalonia"
             xmlns:properties="clr-namespace:RMCL.Properties"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="RMCL.Views.Page.DialogContent.Account.DialogAddOfflineAccountContent">
    <StackPanel>
        <StackPanel Orientation="Horizontal">
            <onePointControls:FontIcon Glyph="&#xECAF;"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"
                                       FontSize="16"
                                       VerticalAlignment="Center"
                                       Margin="0,0,5,0"/>
            
            <TextBlock VerticalAlignment="Center"
                       Margin="5"
                       Text="{x:Static properties:Resource.Account_AddAccount_Offline_UserName}">
            </TextBlock>
        </StackPanel>
        
        <TextBox Margin="0,5,0,5"
                 Name="AccountNameBox"></TextBox>
        
        <notice:InfoBar State="Warning"
                        Title="{x:Static properties:Resource.Account_AddAccount_Offline_Warning_Title}"
                        Margin="0,5,0,5"
                        Message="{x:Static properties:Resource.Account_AddAccount_Offline_Warning}"/>
    </StackPanel>
</UserControl>
