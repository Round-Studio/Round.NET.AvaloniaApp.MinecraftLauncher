<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="RMCL.Views.Page.Main.OnlineSubPage.OnlineHostChooseGame">
    <Grid Margin="15"
          RowDefinitions="Auto,*,Auto">
        <StackPanel Grid.Row="0">
            <ProgressBar Margin="5"
                         Name="LoadBar"
                         IsIndeterminate="True"></ProgressBar>
            
            <TextBlock Margin="5">请在下方列表中选择一个已开启局域网游戏的 Minecraft，然后点击 "创建"。如果没有您的实例，可点击左下角 "刷新" 以刷新列表。</TextBlock>
        </StackPanel>
        
        <ListBox Grid.Row="1"
                 VerticalAlignment="Stretch"
                 HorizontalAlignment="Stretch"
                 Name="SelGameBox">
            
        </ListBox>
        
        
        <Button Grid.Row="2"
                Width="100"
                Height="32"
                Name="RefBtn"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Classes="NoBorder"
                Margin="5">
            <StackPanel Orientation="Horizontal">
                <onePointControls:FontIcon Glyph="&#xE72C;"
                                           VerticalAlignment="Center"
                                           FontSize="16"/>
                    
                <TextBlock FontSize="16"
                           Margin="10,0"
                           VerticalAlignment="Center">刷新</TextBlock>
            </StackPanel>
        </Button>
        
        <StackPanel Grid.Row="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Orientation="Horizontal">
            <Button Width="100"
                    Height="32"
                    Classes="NoBorder"
                    Margin="5">
                <StackPanel Orientation="Horizontal">
                    <onePointControls:FontIcon Glyph="&#xE72B;"
                                               VerticalAlignment="Center"
                                               FontSize="16"/>
                    
                    <TextBlock FontSize="16"
                               Margin="10,0"
                               VerticalAlignment="Center">返回</TextBlock>
                </StackPanel>
            </Button>
            <Button Width="100"
                    Height="32"
                    Classes="NoBorder"
                    Background="{DynamicResource AccentBackgroundBrush}"
                    Margin="5">
                <StackPanel Orientation="Horizontal">
                    <onePointControls:FontIcon Glyph="&#xE710;"
                                               VerticalAlignment="Center"
                                               FontSize="18"/>
                    
                    <TextBlock FontSize="16"
                               VerticalAlignment="Center"
                               Margin="8,0">创建</TextBlock>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
