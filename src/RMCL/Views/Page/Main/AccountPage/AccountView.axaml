<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
             xmlns:view="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls.View;assembly=OnePointUI.Avalonia"
             xmlns:notice="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls.Notice;assembly=OnePointUI.Avalonia"
             xmlns:properties="clr-namespace:RMCL.Properties"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="RMCL.Views.Page.Main.AccountPage.AccountView">
    <Grid RowDefinitions="60,*">
        <ListBox Classes="Segmented"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top"
                 SelectedIndex="0"
                 Height="40"
                 Margin="20,20,0,0">
            <ListBoxItem Classes="Segmented">
                <StackPanel Orientation="Horizontal">
                    <onePointControls:FontIcon Glyph="&#xE71D;"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                    <TextBlock Text="{x:Static properties:Resource.Account_AllType}"></TextBlock>
                </StackPanel>
            </ListBoxItem>
            
            <ListBoxItem Classes="Segmented">
                <StackPanel Orientation="Horizontal">
                    <onePointControls:FontIcon Glyph="&#xF0E2;"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                    <TextBlock Text="{x:Static properties:Resource.Account_Microsoft}"></TextBlock>
                </StackPanel>
            </ListBoxItem>
            
            <ListBoxItem Classes="Segmented">
                <StackPanel Orientation="Horizontal">
                    <onePointControls:FontIcon Glyph="&#xECAF;"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                    <TextBlock Text="{x:Static properties:Resource.Account_Offline}"></TextBlock>
                </StackPanel>
            </ListBoxItem>
            
            <ListBoxItem Classes="Segmented"
                         IsEnabled="False">
                <StackPanel Orientation="Horizontal">
                    <onePointControls:FontIcon Glyph="&#xEBDA;"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                    <TextBlock Text="{x:Static properties:Resource.Account_ThirdPartyVerification}"></TextBlock>
                </StackPanel>
            </ListBoxItem>
        </ListBox>
        
        <Button Grid.Row="0"
                Height="40"
                HorizontalAlignment="Right"
                Classes="NoBorder"
                IsVisible="True"
                Name="AddAccount"
                Click="AddAccount_OnClick"
                Padding="24,0"
                Margin="0,20,20,0">
            <StackPanel Orientation="Horizontal">
                <onePointControls:FontIcon Glyph="&#xE710;"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center"></onePointControls:FontIcon>
                <TextBlock VerticalAlignment="Center" Text="{x:Static properties:Resource.Account_AddAccount}"></TextBlock>
            </StackPanel>
        </Button>
        
        <Grid Grid.Row="1"
              Margin="10">
            <view:ItemView Name="AccountsView"/>
            <notice:IconNotice Glyph="&#xF133;"
                               Message="{x:Static properties:Resource.Account_None}"
                               Name="NoneBox"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</UserControl>
