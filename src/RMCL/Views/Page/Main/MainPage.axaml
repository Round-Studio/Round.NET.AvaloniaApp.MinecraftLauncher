<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:res="clr-namespace:RMCL.Properties"
             xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
             xmlns:mainSubPage="clr-namespace:RMCL.Views.Page.Main.MainSubPage"
             x:Class="RMCL.Views.Page.Main.MainPage">
    <Grid>
        <ContentControl Name="MainPageContent"
                        IsVisible="False">
            <mainSubPage:MainHomePage/>
        </ContentControl>
        
        <Border HorizontalAlignment="Stretch"
                VerticalAlignment="Bottom"
                Height="48"
                Background="{DynamicResource PrimaryBackgroundBrush}">
            <StackPanel Orientation="Horizontal"
                        Margin="4,0,12,0">
                <Button VerticalAlignment="Center"
                        Height="32"
                        Margin="8,0,0,0"
                        Classes="NoBorder"
                        CornerRadius="16">
                    <DockPanel>
                        <onePointControls:FontIcon Glyph="&#xE80F;"
                                                   Foreground="White"
                                                   Margin="12,8,8,8"></onePointControls:FontIcon>
                        <TextBlock Text="{x:Static res:Resource.MainPage_Home}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"></TextBlock>
                    </DockPanel>
                </Button>
                
                <Button VerticalAlignment="Center"
                        Height="32"
                        Margin="8,0,0,0"
                        Classes="NoBorder"
                        CornerRadius="16">
                    <DockPanel>
                        <onePointControls:FontIcon Glyph="&#xE896;"
                                                   Margin="12,8,8,8"></onePointControls:FontIcon>
                        <TextBlock Text="{x:Static res:Resource.MainPage_Download}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"></TextBlock>
                    </DockPanel>
                </Button>
                
                <Button VerticalAlignment="Center"
                        Height="32"
                        Margin="8,0,0,0"
                        Classes="NoBorder"
                        CornerRadius="16">
                    <DockPanel>
                        <onePointControls:FontIcon Glyph="&#xE713;"
                                                   Margin="12,8,8,8"></onePointControls:FontIcon>
                        <TextBlock Text="{x:Static res:Resource.MainPage_Setting}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"></TextBlock>
                    </DockPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
