<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:navigation="clr-namespace:RMCL.Views.Control.Navigation"
             xmlns:navigation1="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls.Navigation;assembly=OnePointUI.Avalonia"
             xmlns:vm="using:RMCL.ViewModels.Page.Main"
             xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
             xmlns:res="clr-namespace:RMCL.Properties"
             mc:Ignorable="d" 
             d:DesignWidth="800" 
             d:DesignHeight="450"
             x:DataType="vm:MainPageViewModel"
             x:Class="RMCL.Views.Page.Main.MainPage">

    <Design.DataContext>
        <vm:MainPageViewModel/>
    </Design.DataContext>
    
    <UserControl.DataContext>
        <vm:MainPageViewModel/>
    </UserControl.DataContext>
    
    <Grid>
        <Grid ColumnDefinitions="Auto,*">
            <!-- 左侧导航栏-->
            <Grid Grid.Column="0"
                  VerticalAlignment="Stretch"
                  HorizontalAlignment="Left">
                <Border VerticalAlignment="Center"
                        HorizontalAlignment="Stretch"
                        CornerRadius="12"
                        ClipToBounds="True"
                        Name="CenterBorder"
                        Margin="12">
                    <Border.Transitions>
                        <Transitions>
                            <ThicknessTransition Duration="0:0:0.26"
                                                 Easing="ExponentialEaseOut"
                                                 Property="Margin"></ThicknessTransition>
                        </Transitions>
                    </Border.Transitions>
                    <Grid>
                        <Grid Background="{DynamicResource BackgroundBrush}"
                              VerticalAlignment="Stretch"
                              HorizontalAlignment="Stretch"
                              Opacity="0.6"></Grid>
                        
                        <navigation:LeftBar VerticalAlignment="Stretch"
                                            HorizontalAlignment="Stretch"
                                            Margin="0,10"
                                            Name="LeftBar"/>
                    </Grid>
                </Border>
            </Grid>
        
            <navigation1:NavigationFrame Grid.Column="1" Name="MainPageContent"
                                         NavigationFrameDirection="Right"></navigation1:NavigationFrame>
        </Grid>
        
        
        <Border HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="12"
                CornerRadius="12"
                Name="LaunchBtn"
                ClipToBounds="True">
            <Border.Transitions>
                <Transitions>
                    <ThicknessTransition Duration="0:0:0.26"
                                         Easing="ExponentialEaseOut"
                                         Property="Margin"></ThicknessTransition>
                </Transitions>
            </Border.Transitions>
            <Grid>
                <Grid Background="{DynamicResource BackgroundBrush}"
                      VerticalAlignment="Stretch"
                      HorizontalAlignment="Stretch"
                      Opacity="0.6"></Grid>
                
                <!-- 启动按钮 -->
                <Button Classes="NoBorder"
                        Background="{DynamicResource AccentBackgroundBrush}"
                        Padding="17,16"
                        MinHeight="56"
                        MaxHeight="56"
                        Margin="10">
                    <StackPanel Orientation="Horizontal">
                        <onePointControls:FontIcon Glyph="&#xE768;"
                                                   FontSize="20"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"
                                                   Foreground="White"
                                                   Margin="0,0,0,0"/>
                                    
                        <TextBlock Text="{x:Static res:Resource.MainPage_Launch}"
                                   Foreground="White"
                                   FontSize="18"
                                   Name="LaunchText"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>