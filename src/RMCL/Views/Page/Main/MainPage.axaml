<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:navigation="clr-namespace:RMCL.Views.Control.Navigation"
             xmlns:navigation1="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls.Navigation;assembly=OnePointUI.Avalonia"
             xmlns:vm="using:RMCL.ViewModels.Page.Main"
             mc:Ignorable="d" 
             d:DesignWidth="800" 
             d:DesignHeight="450"
             x:DataType="vm:MainPageViewModel"
             x:Class="RMCL.Views.Page.Main.MainPage">

    <Design.DataContext>
        <vm:MainPageViewModel/>
    </Design.DataContext>
    
    <UserControl.DataContext>
        <vm:MainPageViewModel/>
    </UserControl.DataContext>
    
    <Grid ColumnDefinitions="Auto,*">
        <!-- 左侧导航栏-->
        <Border Grid.Column="0"
                VerticalAlignment="Stretch"
                HorizontalAlignment="Left">
            <Grid>
                <Border VerticalAlignment="Center"
                        HorizontalAlignment="Stretch"
                        CornerRadius="12"
                        ClipToBounds="True"
                        Margin="12">
                    <Grid>
                        <Grid Background="{DynamicResource BackgroundBrush}"
                              VerticalAlignment="Stretch"
                              HorizontalAlignment="Stretch"
                              Opacity="0.6"></Grid>
                    
                        <navigation:LeftBar VerticalAlignment="Stretch"
                                            HorizontalAlignment="Stretch"
                                            Margin="0,10"
                                            Name="LeftBar"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
        
        <!-- 底部导航栏 大抵是已经要废弃乐，因为太多人说像 lx 了...-->
        <!--<Border Grid.Column="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Bottom"
                IsVisible="False"
                Height="48">
            <Grid>
                <Grid Background="{DynamicResource PrimaryBackgroundBrush}"
                      Opacity="0.85"></Grid>
                
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Margin="15,0"
                            Spacing="8">
                    <Button VerticalAlignment="Center"
                            Height="32"
                            Width="32"
                            Classes="NoBorder"
                            Name="TaskBtn"
                            Click="TaskBtn_OnClick"
                            CornerRadius="16">
                        <onePointControls:FontIcon Glyph="&#xE7C4;"
                                                   FontSize="14"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"/>
                    </Button>
                    
                    <onePointControls:ProgressRing VerticalAlignment="Center"
                                                   HorizontalAlignment="Left"
                                                   Margin="5,0"
                                                   Name="LoadRing"
                                                   RingWidth="3"></onePointControls:ProgressRing>
                </StackPanel>
                
                <navigation:BottomBar HorizontalAlignment="Center"
                                      Name="BottomBar"/>
            </Grid>
        </Border>-->
        
        <navigation1:NavigationFrame Grid.Column="1" Name="MainPageContent"
                                     NavigationFrameDirection="Right"></navigation1:NavigationFrame>
    </Grid>
</UserControl>