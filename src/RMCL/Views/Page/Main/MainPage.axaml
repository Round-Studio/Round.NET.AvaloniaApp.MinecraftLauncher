<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:res="clr-namespace:RMCL.Properties"
             xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
             xmlns:mainSubPage="clr-namespace:RMCL.Views.Page.Main.MainSubPage"
             xmlns:navigation="clr-namespace:RMCL.Views.Control.Navigation"
             mc:Ignorable="d" 
             d:DesignWidth="800" 
             d:DesignHeight="450"
             x:Class="RMCL.Views.Page.Main.MainPage">
    
    <Grid>
        <!--<navigation:NavigationFrame Name="MainPageContent"></navigation:NavigationFrame>-->
        <ContentControl Name="MainContentControl">
            <mainSubPage:MainHomePage></mainSubPage:MainHomePage>
        </ContentControl>
        
        <Button VerticalAlignment="Bottom"
                HorizontalAlignment="Left"
                Margin="15"
                Height="48"
                Width="48"
                Classes="NoBorder"
                CornerRadius="16"
                Name="NavigationBtn"
                Click="NavigationBtn_OnClick">
            <onePointControls:FontIcon Glyph="&#xE7C4;"
                                       FontSize="18"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"/>
        </Button>
    </Grid>
</UserControl>