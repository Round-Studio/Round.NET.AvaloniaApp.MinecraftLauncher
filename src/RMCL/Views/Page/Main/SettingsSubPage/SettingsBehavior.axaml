<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="RMCL.Views.Page.Main.SettingsSubPage.SettingsBehavior">
    <ScrollViewer>
        <StackPanel Margin="15">
            <onePointControls:SettingCard Margin="5"
                                          Header="Java 虚拟机与内存"
                                          Description="Java 与内存的设置、管理 Java"
                                          Glyph="&#xE945;"
                                          IsClickable="True"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
