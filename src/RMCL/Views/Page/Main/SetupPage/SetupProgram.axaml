<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
             xmlns:properties="clr-namespace:RMCL.Properties"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="RMCL.Views.Page.Main.SetupPage.SetupProgram">
    <StackPanel VerticalAlignment="Center"
                Margin="45">
        <StackPanel HorizontalAlignment="Left"
                    VerticalAlignment="Top">
            <onePointControls:FontIcon Margin="5"
                                       FontSize="28"
                                       Glyph="&#xEA86;"
                                       Foreground="{DynamicResource PrimaryForegroundBrush}"/>
            <TextBlock FontSize="22"
                       Margin="5,10,0,0"
                       Text="{x:Static properties:Resource.SetupPage_Program_Title}"></TextBlock>
            <TextBlock Margin="5"
                       Text="{x:Static properties:Resource.SetupPage_Program_SubTitle}"></TextBlock>
        </StackPanel>
        
        <Grid Margin="0,10,0,0">
            <StackPanel Width="310"
                        HorizontalAlignment="Left">
                <DockPanel Margin="5"
                           LastChildFill="True">
                    <ToggleSwitch DockPanel.Dock="Right"
                                  Name="TogglePlugin"
                                  IsCheckedChanged="TogglePlugin_OnIsCheckedChanged"
                                  IsChecked="True"></ToggleSwitch>
                    
                    <TextBlock DockPanel.Dock="Left"
                               Text="{x:Static properties:Resource.SetupPage_Program_Plugin}"></TextBlock>
                </DockPanel>
                
                <DockPanel Margin="5"
                           LastChildFill="True">
                    <ToggleSwitch DockPanel.Dock="Right"
                                  Name="ToggleOnline"
                                  IsCheckedChanged="ToggleOnline_OnIsCheckedChanged"></ToggleSwitch>
                    
                    <TextBlock DockPanel.Dock="Left"
                               Text="{x:Static properties:Resource.SetupPage_Program_Online}"></TextBlock>
                </DockPanel>
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
