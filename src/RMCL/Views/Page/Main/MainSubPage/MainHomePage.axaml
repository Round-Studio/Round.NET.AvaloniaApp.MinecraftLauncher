<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:onePointControls1="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
             xmlns:res="clr-namespace:RMCL.Properties"
             xmlns:notice="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls.Notice;assembly=OnePointUI.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="RMCL.Views.Page.Main.MainSubPage.MainHomePage">
    <Grid>
        <!-- 固定按钮 -->
        <Button Classes="NoBorder"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                CornerRadius="16"
                Margin="0,0,15,62"
                Padding="12,4">
            <Button.Styles>
                <Style Selector="Button">
                    <Style.Animations>
                        <Animation Duration="0:0:1"
                                   Easing="ExponentialEaseOut">
                            <KeyFrame Cue="0%">
                                <Setter Property="Margin"
                                        Value="0,200,15,-200"></Setter>
                            </KeyFrame>
                            <KeyFrame Cue="98%">
                                <Setter Property="ScaleTransform.ScaleX" Value="1.05"/>
                                <Setter Property="ScaleTransform.ScaleY" Value="1.05"/>
                            </KeyFrame>
                            <KeyFrame Cue="100%">
                                <Setter Property="Margin"
                                        Value="0,0,15,62"></Setter>
                                <Setter Property="ScaleTransform.ScaleX" Value="1"/>
                                <Setter Property="ScaleTransform.ScaleY" Value="1"/>
                            </KeyFrame>
                        </Animation>
                    </Style.Animations>
                </Style>
            </Button.Styles>
            
            <StackPanel Orientation="Horizontal">
                <TextBlock FontSize="72"
                           FontWeight="Bold"
                           FontFamily="{DynamicResource DinPro}"
                           Text="{x:Static res:Resource.MainPage_Home_NoPin}"></TextBlock>
                <onePointControls1:FontIcon Glyph="&#xE971;"
                                            VerticalAlignment="Center"
                                            IsVisible="False"
                                            Margin="8,0,0,0"></onePointControls1:FontIcon>
            </StackPanel>
        </Button>
        
        <!-- 启动按钮 -->
        <Button Classes="NoBorder"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                CornerRadius="16"
                Margin="15"
                Background="{DynamicResource AccentBorderBrush}"
                Height="32"
                Click="Button_OnClick"
                MinWidth="120">
            <Button.Styles>
                <Style Selector="Button">
                    <Style.Animations>
                        <Animation Duration="0:0:1"
                                   Easing="ExponentialEaseOut">
                            <KeyFrame Cue="0%">
                                <Setter Property="Margin"
                                        Value="0,200,15,-200"></Setter>
                            </KeyFrame>
                            <KeyFrame Cue="90%">
                                <Setter Property="Margin"
                                        Value="15"></Setter>
                            </KeyFrame>
                            <KeyFrame Cue="98%">
                                <Setter Property="ScaleTransform.ScaleX" Value="1.05"/>
                                <Setter Property="ScaleTransform.ScaleY" Value="1.05"/>
                            </KeyFrame>
                            <KeyFrame Cue="100%">
                                <Setter Property="Margin"
                                        Value="15"></Setter>
                                <Setter Property="ScaleTransform.ScaleX" Value="1"/>
                                <Setter Property="ScaleTransform.ScaleY" Value="1"/>
                            </KeyFrame>
                        </Animation>
                    </Style.Animations>
                </Style>
            </Button.Styles>
            <StackPanel Orientation="Horizontal"
                        Margin="12,0">
                <onePointControls1:FontIcon Glyph="&#xE768;"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Foreground="White"
                                           Margin="0,0,8,0"/>
                        
                <TextBlock Text="{x:Static res:Resource.MainPage_Launch}"
                           Foreground="White"
                           VerticalAlignment="Center"
                           FontWeight="Bold"/>
            </StackPanel>
        </Button>
        
        <notice:InfoBar State="Warning"
                        Title="预览版警告"
                        Message="当前版本为 RMCL 4 的预览版，仅作为 UI/UX 预览，并不代表最终品质。"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="20"/>
    </Grid>
</UserControl>
