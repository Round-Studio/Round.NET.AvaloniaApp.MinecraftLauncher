<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:onePointControls1="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
             xmlns:res="clr-namespace:RMCL.Properties"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="RMCL.Views.Page.Main.MainSubPage.MainHomePage">
    <Grid>
       
        <!-- 启动按钮 -->
        <Button Classes="NoBorder"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                CornerRadius="16"
                Margin="15"
                Background="{DynamicResource AccentBorderBrush}"
                Height="32"
                MinWidth="120">
            <StackPanel Orientation="Horizontal"
                        Margin="12,0">
                <onePointControls1:FontIcon Glyph="&#xE768;"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Foreground="White"
                                           Margin="0,0,8,0"/>
                        
                <TextBlock Text="{x:Static res:Resource.MainPage_Launch}"
                           Foreground="White"
                           VerticalAlignment="Center"
                           FontWeight="Bold"/>
            </StackPanel>
        </Button>
    </Grid>
</UserControl>
