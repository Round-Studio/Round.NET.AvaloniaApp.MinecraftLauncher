<interface:IPage xmlns="https://github.com/avaloniaui"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
       xmlns:interface="clr-namespace:RMCL.Interface"
       xmlns:items="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls.Items;assembly=OnePointUI.Avalonia"
       xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
       mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
       x:Class="RMCL.Views.Pages.MainPages.HomePage">
    <interface:IPage.TopNavBar>
        <items:BorderCard>
            <StackPanel Orientation="Horizontal"
                        Spacing="8">
                <Button Classes="NoBorder"
                        Height="32"
                        Padding="8">
                    <StackPanel Orientation="Horizontal"
                                Spacing="6">
                        <onePointControls:FontIcon VerticalAlignment="Center"
                                                   Glyph="&#xE7FC;" />
                        <TextBlock Text="Instance" />
                    </StackPanel>
                </Button>
                <Button Classes="NoBorder"
                        Height="32"
                        Padding="8">
                    <StackPanel Orientation="Horizontal"
                                Spacing="6">
                        <onePointControls:FontIcon VerticalAlignment="Center"
                                                   Glyph="&#xE896;" />
                        <TextBlock Text="Download" />
                    </StackPanel>
                </Button>
                <Button Classes="NoBorder"
                        Height="32"
                        Padding="8">
                    <StackPanel Orientation="Horizontal"
                                Spacing="6">
                        <onePointControls:FontIcon VerticalAlignment="Center"
                                                   Glyph="&#xE713;" />
                        <TextBlock Text="Setting" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </items:BorderCard>
    </interface:IPage.TopNavBar>
</interface:IPage>
