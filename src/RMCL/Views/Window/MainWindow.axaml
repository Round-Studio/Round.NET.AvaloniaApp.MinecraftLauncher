<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RMCL.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:page="clr-namespace:RMCL.Views.Page"
        xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
        xmlns:res="clr-namespace:RMCL.Properties"
        xmlns:notice="clr-namespace:RMCL.Views.Control.Notice"
        xmlns:tasks="clr-namespace:RMCL.Views.Control.Tasks"
        xmlns:dialog="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls.Dialog;assembly=OnePointUI.Avalonia"
        xmlns:notice1="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls.Notice;assembly=OnePointUI.Avalonia"
        xmlns:dialogHostAvalonia="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="RMCL.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/Icon/RMCL4.Logo.Big.ico"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        ExtendClientAreaChromeHints="NoChrome"
        WindowStartupLocation="CenterScreen"
        Width="1000" MinWidth="1000"
        Height="560" MinHeight="560"
        Background="Transparent"
        Closing="TopLevel_OnClosing"
        Title="{Binding WindowTitle}">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid>
        <Grid Name="AccentBackgroundBox"
              Background="{DynamicResource AccentBackgroundBrush}"
              IsVisible="False"></Grid>
        
        <Grid Name="BackgroundBox"
              IsVisible="False">
            <Grid.Effect>
                <BlurEffect Radius="0"></BlurEffect>
            </Grid.Effect>
            <Grid Name="BackgroundImage"></Grid>
            <Grid Name="BackgroundImageOpacity"
                  Opacity="0"
                  Background="{DynamicResource BackgroundBrush}"></Grid>
        </Grid>
        
        <Image Source="../../Assets/Image/蜂窝.Background.png"
               Width="322.5" Height="165"
               HorizontalAlignment="Right"
               VerticalAlignment="Top"
               Margin="0,32,0,0"
               Name="RightImage"
               Opacity="0.9">
            <Image.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity"
                                      Duration="0:0:0.18"></DoubleTransition>
                </Transitions>
            </Image.Transitions>
        </Image>
        
        <Image Source="../../Assets/Image/蜂窝.Background.png"
               Width="322.5" Height="165"
               HorizontalAlignment="Left"
               VerticalAlignment="Bottom"
               Name="LeftImage"
               Margin="0,0,0,48"
               Opacity="0.9">
            <Image.RenderTransform>
                <RotateTransform Angle="180"/>
            </Image.RenderTransform>
            <Image.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity"
                                      Duration="0:0:0.18"></DoubleTransition>
                </Transitions>
            </Image.Transitions>
        </Image>
        
        <Grid Margin="0,32,0,0">
            <page:MainView/>
        </Grid>
            
        <notice:NoticePanel HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Name="NoticePanel"
                            Margin="0,0,0,59"/>
            
        <tasks:TaskPanel HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Name="TaskPanel"/>
        
        <!--<dialog:DialogHost/>-->
        <!--上面的事我们自己的那一坨，用都不想用-->
        
        <dialogHostAvalonia:DialogHost CloseOnClickAway="False">
            <dialogHostAvalonia:DialogHost.DialogContent>
                <!-- put your dialog content here-->
            </dialogHostAvalonia:DialogHost.DialogContent>
        </dialogHostAvalonia:DialogHost>
        
        <Grid HorizontalAlignment="Stretch"
              VerticalAlignment="Top"
              PointerPressed="InputElement_OnPointerPressed"
              Background="{DynamicResource PrimaryBackgroundBrush}"
              Height="32">
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"
                        Margin="15,0,0,0">
                <TextBlock FontSize="16">RMCL</TextBlock>
            </StackPanel>
        
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Height="22"
                    ClipToBounds="True"
                    CornerRadius="6">
                <notice1:InfoBar State="Warning"
                                 VerticalAlignment="Center"
                                 Title="预览版警告"
                                 Message="当前版本为 RMCL 4 的预览版，仅作为 UI/UX 预览，并不代表最终品质。"
                                 Margin="0"/>
            </Border>
            
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"
                        Margin="0,0,15,0">
                <Button Classes="NoBorder"
                        Width="22" Height="22"
                        Name="MinBtn"
                        Click="MinBtn_OnClick"
                        Margin="5,0,0,0">
                    <onePointControls:FontIcon Glyph="&#xE921;"/>
                </Button>
                <Button Classes="NoBorder"
                        Width="22" Height="22"
                        Name="MaxBtn"
                        Click="MaxBtn_OnClick"
                        Margin="5,0,0,0">
                    <onePointControls:FontIcon Glyph="&#xE922;"/>
                </Button>
                <Button Classes="NoBorder"
                        Width="22" Height="22"
                        Name="CloseBtn"
                        Click="CloseBtn_OnClick"
                        Margin="5,0,0,0">
                    <onePointControls:FontIcon Glyph="&#xE8BB;"/>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
