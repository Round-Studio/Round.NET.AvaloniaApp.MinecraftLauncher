<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:onePointControls="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls;assembly=OnePointUI.Avalonia"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="72"
             Width="300" Height="72"
             x:Class="RMCL.Views.Control.Item.AccountChooseItem">
    <Grid>
        <onePointControls:ProgressRing Width="32"
                                       Height="32"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       Margin="18"
                                       Background="Transparent"/>
        
        <Image Width="48"
               Height="48"
               HorizontalAlignment="Left"
               VerticalAlignment="Center"
               Margin="12"
               Name="HeadIconImage"></Image>
        
        <Grid Margin="72,12,12,12">
            <StackPanel VerticalAlignment="Center">
                <TextBlock FontSize="18" Name="AccountName"></TextBlock>
                <TextBlock FontSize="11" Name="AccountTypeBox"></TextBlock>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
