<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="200" d:DesignHeight="120"
             MinHeight="120" MinWidth="200"
             x:Class="RMCL.Views.Control.StyleBox">
    <Border CornerRadius="6"
            BoxShadow="0 0 5 Gray"
            Margin="5">
        <Border ClipToBounds="True">
            <Grid>
                <Border Name="BackgroundBox"
                        CornerRadius="6,6,6,6"></Border>
                
                <Border Name="AccentBackgroundBox"
                        CornerRadius="6,6,6,6"
                        Background="{DynamicResource AccentBackgroundBrush}"
                        IsVisible="False"></Border>
                
                <Image Source="../../Assets/Image/电路板.Background.png"
                       Width="86.8" Height="32"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Top"
                       Name="RightImage"
                       Margin="0,0,0,0"
                       Opacity="0.3"></Image>
        
                <Image Source="../../Assets/Image/电路板.Background.png"
                       Width="86.8" Height="32"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Bottom"
                       Name="LeftImage"
                       Margin="0,0,0,6"
                       Opacity="0.3">
                    <Image.RenderTransform>
                        <RotateTransform Angle="180"/>
                    </Image.RenderTransform>
                </Image>
                
                <Border Width="8" Height="40"
                        Background="{DynamicResource PrimaryForegroundBrush}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        CornerRadius="2"
                        Margin="4"></Border>
                
                <Border Width="30" Height="12"
                        Background="{DynamicResource PrimaryForegroundBrush}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        CornerRadius="2"
                        Margin="4,4,4,11"></Border>
                
                <Grid VerticalAlignment="Bottom">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                
                    <Border Grid.Column="0" Height="6"
                            CornerRadius="0,0,0,6"
                            Background="{DynamicResource AccentBackgroundBrush}"></Border>
                    <Border Grid.Column="1" Height="6"
                            Background="{DynamicResource AccentBorderBrush}"></Border>
                    <Border Grid.Column="2" Height="6"
                            CornerRadius="0,0,6,0"
                            Background="{DynamicResource AccentBackgroundOverBrush}"></Border>
                </Grid>
            </Grid>
        </Border>
    </Border>
</UserControl>
