<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:selectBar="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls.Navigation.SelectBar;assembly=OnePointUI.Avalonia"
             xmlns:leftSelectBar="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls.Navigation.LeftSelectBar;assembly=OnePointUI.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="RMCL.Views.Control.Navigation.LeftBar">
    <leftSelectBar:LeftSelectBar VerticalAlignment="Center"
                                 HorizontalAlignment="Center"
                                 Margin="5,0"
                                 SelectionChanged="ItemsPanel_OnSelectionChanged"
                                 Name="ItemsPanel">
    </leftSelectBar:LeftSelectBar>
</UserControl>
